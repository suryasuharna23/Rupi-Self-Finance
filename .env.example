# Salin ke .env lalu isi. Jangan commit .env.
DATABASE_URL=postgres://rupi:rupi@localhost:5432/rupi?sslmode=disable
TELEGRAM_BOT_TOKEN=
# Ganti hanya untuk test dengan server Telegram tiruan
TELEGRAM_API_URL=https://api.telegram.org
# polling untuk lokal; webhook butuh URL publik + secret (SEC-01)
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
HTTP_ADDR=:8080
LOG_LEVEL=info
