# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://rupi:rupi@localhost:5432/rupi?sslmode=disable
TELEGRAM_BOT_TOKEN=
# Change only to test against a fake Telegram server
TELEGRAM_API_URL=https://api.telegram.org
# polling for local use; webhook needs a public URL + secret (SEC-01)
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
HTTP_ADDR=:8080
LOG_LEVEL=info
